{
  "name": "msg-hub",
  "version": "0.1.0",
  "description": "Hub komunikatorow z izolowanymi sesjami kont",
  "author": "Marek Kencki",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mkencki/msg-hub.git"
  },
  "homepage": "https://github.com/mkencki/msg-hub",
  "main": "src/glowny/main.js",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "dist": "electron-builder --win portable --publish never",
    "dist:instalator": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "electron": "43.4.1",
    "electron-builder": "^26.15.3",
    "vitest": "4.1.11"
  },
  "build": {
    "appId": "pl.kencki.msghub",
    "productName": "msg-hub",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/ikona.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "msg-hub",
      "artifactName": "msg-hub-${version}-instalator.exe",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "msg-hub-${version}-portable.exe"
    }
  }
}
